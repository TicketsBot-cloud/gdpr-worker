# Logging Configuration
JSON_LOGS=
LOG_LEVEL=

# Settings
MAX_CONCURRENCY=
MAX_RETRIES=

# Database Configuration
DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_THREADS=5

# Redis Configuration
REDIS_ADDR=
REDIS_PASSWD=
REDIS_THREADS=

# Archiver Configuration
ARCHIVER_URL=
ARCHIVER_AES_KEY=

# Discord Configuration
DISCORD_PROXY_URL=
DISCORD_TOKEN=

# Cache Database Configuration (optional)
# When unset, exports omit cache.json and record the omission in the manifest.
CACHE_HOST=
CACHE_NAME=
CACHE_USER=
CACHE_PASSWORD=
CACHE_THREADS=

# Data Export Configuration
# Discord caps a request at 25 MiB, an attachment at 20 MiB, and a message at 10 attachments.
# 12 MiB parts put two per message, using the request budget almost exactly.
EXPORT_MAX_PART_BYTES=
EXPORT_MAX_MESSAGE_BYTES=
EXPORT_MAX_ATTACHMENT_BYTES=
EXPORT_DM_DELAY=
EXPORT_TIMEOUT=
EXPORT_CONCURRENCY=
